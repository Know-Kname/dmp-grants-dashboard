# ============================================
# DMP Cemetery Management - Environment Variables
# ============================================
# Copy this file to .env and update values
# NEVER commit the .env file

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dmp_cemetery

# --- Authentication ---
JWT_SECRET=your-secret-key-change-this

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Comma-separated origins allowed to access the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Vercel (for deployment) ---
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id

# --- Frontend (prefix with VITE_ for client access) ---
VITE_API_URL=http://localhost:3000

# --- External Integrations ---
# LINEAR_API_KEY=your-linear-api-key
# FIGMA_ACCESS_TOKEN=your-figma-token
# NOTION_API_KEY=your-notion-api-key
