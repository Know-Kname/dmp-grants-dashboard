# .env.example — copy to .env.local for local development
# NEVER commit .env.local — it is in .gitignore
# Every new environment variable MUST be added here with a descriptive comment
# Production secrets are managed via Azure Key Vault
# ─────────────────────────────────────────────────────────────────

# ── SUPABASE (PUBLIC — safe to expose to browser, controlled by RLS) ─
# Project URL. Found in: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://mgpwjnxtqcnoyjgebytg.supabase.co

# Anonymous key. Respects RLS policies. Safe to expose publicly.
# Found in: Supabase Dashboard → Settings → API → anon (public)
VITE_SUPABASE_ANON_KEY=eyJ...

# ── AI ASSISTANT (PUBLIC — visible in browser bundle) ──────────────
# OpenRouter API key for Gemini 2.5 Pro (google/gemini-2.5-pro) streaming.
# WARNING: This key is compiled into the JS bundle and visible in DevTools.
# For production hardening, move to a Vercel Edge Function proxy (see docs/09-security.md).
# Found in: openrouter.ai → Keys
VITE_OPENROUTER_API_KEY=sk-or-...
