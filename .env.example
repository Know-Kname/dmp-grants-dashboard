# ─── Supabase (required) ──────────────────────────────────────────────────────
# Your Supabase project URL — found in: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase public anon key — safe to expose in frontend code
# Found in: Supabase dashboard → Settings → API → Project API keys → anon/public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OpenRouter / AI Assistant (optional) ─────────────────────────────────────
# Powers the Gemini 2.5 Pro chat assistant. App works without this — assistant
# button is present but will return an error if the key is missing.
# Get a key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-...
