{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // ── Strict gate used by `npm run build:strict` and CI ──
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
